diff --git a/gui/include/externalinput.h b/gui/include/externalinput.h
new file mode 100644
index 0000000..0b405c5
--- /dev/null
+++ b/gui/include/externalinput.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#ifndef CHIAKI_EXTERNALINPUT_H
+#define CHIAKI_EXTERNALINPUT_H
+
+#include <chiaki/controller.h>
+
+#include <QObject>
+
+class QTimer;
+class QUdpSocket;
+
+/**
+ * Receives a controller state from another local process (e.g. the gtrainer
+ * bike-trainer bridge) over UDP on 127.0.0.1 and exposes it as one more input
+ * source, merged by StreamSession like any physical controller.
+ *
+ * Port: CHIAKI_EXTERNAL_INPUT_PORT env var (default 47800, 0 disables).
+ *
+ * Packet (23 bytes, little-endian):
+ *   char[4] magic "CTRN" | u8 version (1) | u32 sequence |
+ *   u32 buttons (ChiakiControllerButton bits) | u8 l2 | u8 r2 |
+ *   i16 left_x | i16 left_y | i16 right_x | i16 right_y
+ *
+ * If no valid packet arrives for TIMEOUT_MS the state falls back to idle, so a
+ * crashed sender can never leave a button or trigger held.
+ */
+class ExternalInput : public QObject
+{
+	Q_OBJECT
+
+	public:
+		static const int PACKET_SIZE = 23;
+		static const quint8 PROTOCOL_VERSION = 1;
+		static const quint16 DEFAULT_PORT = 47800;
+		static const int TIMEOUT_MS = 250;
+
+		explicit ExternalInput(QObject *parent = nullptr);
+
+		ChiakiControllerState GetState() const { return state; }
+		bool IsListening() const { return socket != nullptr; }
+
+	signals:
+		void StateChanged();
+
+	private slots:
+		void ReadPendingDatagrams();
+		void Timeout();
+
+	private:
+		bool Parse(const QByteArray &data);
+
+		QUdpSocket *socket = nullptr;
+		QTimer *timeout_timer = nullptr;
+		ChiakiControllerState state;
+		quint32 last_seq = 0;
+		bool have_seq = false;
+};
+
+#endif // CHIAKI_EXTERNALINPUT_H
