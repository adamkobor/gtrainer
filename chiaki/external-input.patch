diff --git a/gui/src/externalinput.cpp b/gui/src/externalinput.cpp
new file mode 100644
index 0000000..7931678
--- /dev/null
+++ b/gui/src/externalinput.cpp
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#include "externalinput.h"
+
+#include <QHostAddress>
+#include <QTimer>
+#include <QUdpSocket>
+#include <QtEndian>
+#include <QDebug>
+
+#include <cstring>
+
+static bool SameInput(const ChiakiControllerState &a, const ChiakiControllerState &b)
+{
+	return a.buttons == b.buttons
+		&& a.l2_state == b.l2_state && a.r2_state == b.r2_state
+		&& a.left_x == b.left_x && a.left_y == b.left_y
+		&& a.right_x == b.right_x && a.right_y == b.right_y;
+}
+
+ExternalInput::ExternalInput(QObject *parent)
+	: QObject(parent)
+{
+	chiaki_controller_state_set_idle(&state);
+
+	timeout_timer = new QTimer(this);
+	timeout_timer->setSingleShot(true);
+	timeout_timer->setInterval(TIMEOUT_MS);
+	connect(timeout_timer, &QTimer::timeout, this, &ExternalInput::Timeout);
+
+	quint16 port = DEFAULT_PORT;
+	const QByteArray env = qgetenv("CHIAKI_EXTERNAL_INPUT_PORT");
+	if(!env.isEmpty())
+	{
+		bool ok = false;
+		const uint value = env.toUInt(&ok);
+		if(!ok || value > 65535)
+		{
+			qWarning() << "External input: invalid CHIAKI_EXTERNAL_INPUT_PORT" << env << "- disabled";
+			return;
+		}
+		port = static_cast<quint16>(value);
+	}
+	if(port == 0)
+	{
+		qInfo() << "External input: disabled";
+		return;
+	}
+
+	auto *udp = new QUdpSocket(this);
+	if(!udp->bind(QHostAddress::LocalHost, port))
+	{
+		qWarning() << "External input: failed to bind 127.0.0.1:" << port << "-" << udp->errorString();
+		delete udp;
+		return;
+	}
+	socket = udp;
+	connect(socket, &QUdpSocket::readyRead, this, &ExternalInput::ReadPendingDatagrams);
+	qInfo() << "External input: listening on 127.0.0.1:" << port;
+}
+
+void ExternalInput::ReadPendingDatagrams()
+{
+	const ChiakiControllerState before = state;
+	while(socket->hasPendingDatagrams())
+	{
+		QByteArray data;
+		data.resize(static_cast<int>(socket->pendingDatagramSize()));
+		if(socket->readDatagram(data.data(), data.size()) < 0)
+			continue;
+		Parse(data);
+	}
+	if(!SameInput(before, state))
+		emit StateChanged();
+}
+
+bool ExternalInput::Parse(const QByteArray &data)
+{
+	if(data.size() != PACKET_SIZE)
+		return false;
+	const auto *p = reinterpret_cast<const uchar *>(data.constData());
+	if(std::memcmp(p, "CTRN", 4) != 0 || p[4] != PROTOCOL_VERSION)
+		return false;
+
+	// Drop stale/reordered packets. have_seq is cleared on timeout, so a
+	// restarted sender (sequence back at 0) is accepted again after TIMEOUT_MS.
+	const quint32 seq = qFromLittleEndian<quint32>(p + 5);
+	if(have_seq && static_cast<qint32>(seq - last_seq) <= 0)
+		return false;
+	have_seq = true;
+	last_seq = seq;
+
+	ChiakiControllerState s;
+	chiaki_controller_state_set_idle(&s);
+	s.buttons = qFromLittleEndian<quint32>(p + 9) & ((1u << CHIAKI_CONTROLLER_BUTTONS_COUNT) - 1);
+	s.l2_state = p[13];
+	s.r2_state = p[14];
+	s.left_x = qFromLittleEndian<qint16>(p + 15);
+	s.left_y = qFromLittleEndian<qint16>(p + 17);
+	s.right_x = qFromLittleEndian<qint16>(p + 19);
+	s.right_y = qFromLittleEndian<qint16>(p + 21);
+	state = s;
+
+	timeout_timer->start();
+	return true;
+}
+
+void ExternalInput::Timeout()
+{
+	have_seq = false;
+	const ChiakiControllerState before = state;
+	chiaki_controller_state_set_idle(&state);
+	if(!SameInput(before, state))
+		emit StateChanged();
+}
